# Supabase Configuration (Shared Project: qwaehqsmodekbgvnaavz)
# Vercel environment variables are NOT automatically available on local :3000.
# Copy this file to .env.local, fill the current public key, then restart npm run dev.
#
# Only the public anon/publishable key belongs here. NEVER put a service-role
# or secret key in a VITE_ variable — anything prefixed VITE_ is shipped to the
# browser bundle.
VITE_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
VITE_SUPABASE_ANON_KEY=

# Nexora universal auth storage key (shared by the main website + this PWA so a
# session created on one surface is picked up by the other). The app falls back
# to this exact value when the variable is unset.
VITE_SUPABASE_STORAGE_KEY=nexora.auth.qwaehqsmodekbgvnaavz

# Gemini AI Configuration
GEMINI_API_KEY=
